{
  "name": "clapp",
  "version": "0.0.1",
  "description": "Offline desktop app for SLM Kelompok Cilandak A — member roster, attendance, monthly reports, meetings, circulars, event log.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "SLM Kelompok Cilandak A",
  "license": "UNLICENSED",
  "scripts": {
    "predev": "electron-rebuild -w better-sqlite3 -f",
    "dev": "node scripts/run-electron.mjs electron-vite dev",
    "prebuild": "electron-rebuild -w better-sqlite3 -f",
    "build": "npm run typecheck && electron-vite build",
    "preview": "node scripts/run-electron.mjs electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "pretest": "npm rebuild better-sqlite3 --silent",
    "test": "vitest run",
    "posttest": "electron-rebuild -w better-sqlite3 -f",
    "db:generate": "drizzle-kit generate",
    "rebuild:electron": "electron-rebuild -w better-sqlite3 -f -f",
    "rebuild:node": "npm rebuild better-sqlite3",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.3",
    "better-sqlite3": "^11.5.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.0",
    "electron": "^32.2.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
